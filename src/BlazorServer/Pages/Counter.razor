@page "/counter"

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<p role="status">Current count: @currentCount</p>

<button disabled="@(!enabled)" class="btn btn-primary" @onclick="IncrementCount">Click me</button>

<input id="my-checkbox" type="checkbox" @bind="@enabled" />
<label for="my-checkbox">Enabled</label>

@code {
    private int currentCount = 0;
    private bool enabled = false;

    private void IncrementCount()
    {
        currentCount++;
    }
}
