@code {
    #nullable enable
    [Parameter, EditorRequired] public string StartID { get; set; }
    [Parameter, EditorRequired] public string EndID { get; set; }
    [Parameter] public LeaderLineOptions? Options { get; set; }
    [Inject] public IJSRuntime JS { get; set; }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await AddTheLine();
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task AddTheLine()
    {
        var module = await JS.InvokeAsync<IJSObjectReference>(
            "import", "./Components/AddLeaderLines.razor.js");
        await module.InvokeVoidAsync("addLine", StartID, EndID, Options ?? new LeaderLineOptions());
        await module.DisposeAsync();
    }

    public record LeaderLineOptions(
        dynamic? Dash = null, 
        string? Color = "black",
        int? Size = 2,
        string? Path = "straight",
        string? StartSocket = "auto",
        string? EndSocket = "auto",
        string? StartPlug = "behind",
        string? EndPlug = "behind");
    
    public record DashOptions(int? Len = 10, int? Gap = 10);

}